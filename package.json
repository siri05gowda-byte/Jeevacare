{
  "name": "jeevacare",
  "version": "0.1.0",
  "description": "JeevaCare - One Life. One Health Journey.",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=client & npm run dev --workspace=server",
    "build": "npm run build --workspace=client",
    "test": "npm run test:all",
    "test:backend": "npm run test --workspace=server",
    "test:frontend": "cd client && vitest run",
    "test:all": "npm run test:backend && npm run test:frontend",
    "test:quick": "cd server && vitest run src/utils/*.test.js",
    "lint": "npm run lint --workspaces",
    "start:server": "npm run dev --workspace=server",
    "start:client": "npm run dev --workspace=client",
    "seed:synthetic": "node server/src/scripts/seedSyntheticData.js"
  },
  "keywords": [
    "healthcare",
    "patient-records",
    "lifelong-health",
    "medical-continuity"
  ],
  "author": "JeevaCare Team",
  "license": "Apache-2.0"
}

# JeevaCare Server Environment Configuration Template
# Copy to .env and fill in actual values for your environment

NODE_ENV=development
PORT=5000

# === DATABASE ===
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=JeevaCare
TEST_MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/jeevacare-test?appName=JeevaCare

# === JWT AUTHENTICATION ===
JWT_SECRET=your-secret-jwt-key-minimum-32-characters
JWT_EXPIRATION=24h
REFRESH_TOKEN_SECRET=your-refresh-token-secret-minimum-32-characters
REFRESH_TOKEN_EXPIRATION=7d

# === CLOUDINARY IMAGE & DOCUMENT STORAGE ===
# Get credentials from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# === TEXT-TO-SPEECH (TTS) SERVICE PROVIDER ===
# Primary: 'bhashini' (cloud API, 13 Indian languages), Fallback: 'piper' (local, fewer languages)
TTS_SERVICE_PROVIDER=bhashini

# === BHASHINI TEXT-TO-SPEECH (Cloud, Government of India API) ===
# Get credentials from https://bhashini.gov.in/ulca/user/register
# Supports 13 Indian languages: as, bn, gu, hi, kn, ml, mr, or, pa, ta, te, en, mai
BHASHINI_API_KEY=your-bhashini-api-key-here
BHASHINI_USER_ID=your-bhashini-user-id-here
BHASHINI_API_ENDPOINT=https://dhruva-api.bhashini.gov.in/services

# === PIPER TEXT-TO-SPEECH (Local, Free, Self-Hosted Fallback) ===
# Setup guide: PIPER_TTS_SETUP.md
# Set to true when Piper is installed locally or running as service
PIPER_TTS_ENABLED=false

# Windows example: C:\Users\username\AppData\Local\Programs\Python\Python311\Scripts\piper.exe
# Linux example: piper (if installed via pip install piper-tts)
# Leave blank to use platform defaults
PIPER_BINARY_PATH=

# Windows example: C:\Users\username\piper-models
# Linux example: /data/piper-models (for Docker) or /usr/share/piper-tts/models
# Leave blank to use platform defaults
PIPER_MODELS_PATH=

# Supported languages with verified models: en, hi, ml
# Other languages (kn, ta, te) do not have official Piper models as of Oct 2026
PIPER_DEFAULT_VOICE=en

# === AI SERVICE (Groq) ===
# Get key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=mixtral-8x7b-32768

# === EMERGENCY ACCESS TOKENS ===
# Secret for hashing emergency access tokens (recommend 32+ chars in production)
# Default: 'dev-emergency-secret-change-in-production'
EMERGENCY_TOKEN_SECRET=your-emergency-token-secret-minimum-32-characters

# Emergency token expiration in days
# Default: 365 (1 year)
EMERGENCY_TOKEN_EXPIRY_DAYS=365

# === MEDICAL IMAGE AI (Zero-Cost Pretrained Models) ===
# Enable/disable medical image analysis (chest X-rays, etc.)
# Requires manual model setup - see docs/MEDICAL_IMAGE_AI_SETUP.md
MEDICAL_IMAGE_AI_ENABLED=false

# Path to downloaded model weights (ONNX format recommended)
# Example: ./server/models/chexnet.onnx
# Leave empty to use mock mode (development/testing)
MEDICAL_IMAGE_AI_MODEL_PATH=

# Device for inference: cpu or gpu
# Default: cpu (works on Render but requires sufficient RAM)
MEDICAL_IMAGE_AI_DEVICE=cpu

# === OTP (One-Time Password) ===
OTP_ENABLED=false
OTP_PROVIDER=console

# === CORS & SECURITY ===
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# === LOGGING ===
LOG_LEVEL=info
LOG_FORMAT=combined

# === GOOGLE SHEETS SYNCHRONIZATION (Secondary Demo Sync Layer) ===
# 1. Create a Google Sheet titled "JeevaCare Demo Database" with 7 tabs:
#    [Hospitals, Users, Doctors, Patients, StaffRegistrationRequests, MedicalReports, AuditLog]
# 2. In Google Cloud Console, create a Service Account, generate a JSON Key, and share the Google Sheet with Editor access.
# 3. Add these variables to your environment / Render Dashboard:
GOOGLE_SHEETS_SPREADSHEET_ID=your-google-sheets-spreadsheet-id
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project-id.iam.gserviceaccount.com
# Canonical private key variable (handles escaped \n sequences and surrounding quotes):
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
# Supported alias: GOOGLE_PRIVATE_KEY (automatically recognized as fallback)
# GOOGLE_PRIVATE_KEY=
# Optional fallback webhook URL:
# GOOGLE_SHEETS_WEBHOOK_URL=

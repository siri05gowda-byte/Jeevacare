# Server Configuration
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/jeevacare

# JWT
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_EXPIRATION=24h
REFRESH_TOKEN_SECRET=your-refresh-token-secret-change-in-production
REFRESH_TOKEN_EXPIRATION=7d

# OTP Configuration (optional)
OTP_ENABLED=false
OTP_PROVIDER=console
SMS_API_KEY=
SMS_API_URL=
EMAIL_API_KEY=
EMAIL_API_URL=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI Service
AI_SERVICE_ENABLED=false
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=
AI_MODEL=llama-2

# OCR Service
OCR_SERVICE_ENABLED=false
OCR_SERVICE_URL=http://localhost:8080

# Text-to-Speech
TTS_SERVICE_ENABLED=false
TTS_SERVICE_PROVIDER=google
TTS_API_KEY=

# DigiLocker Integration
DIGILOCKER_ENABLED=false
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_REDIRECT_URI=

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Logging
LOG_LEVEL=info
LOG_FORMAT=combined

# Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

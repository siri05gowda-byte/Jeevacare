# JeevaCare Server Environment Configuration Template
# Copy to .env and fill in actual values for your environment

NODE_ENV=development
PORT=5000

# === DATABASE ===
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=JeevaCare
TEST_MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/jeevacare-test?appName=JeevaCare

# === JWT AUTHENTICATION ===
JWT_SECRET=your-secret-jwt-key-minimum-32-characters
JWT_EXPIRATION=24h
REFRESH_TOKEN_SECRET=your-refresh-token-secret-minimum-32-characters
REFRESH_TOKEN_EXPIRATION=7d

# === CLOUDINARY IMAGE & DOCUMENT STORAGE ===
# Get credentials from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# === PIPER TEXT-TO-SPEECH (Local, Free, Self-Hosted) ===
# Setup guide: PIPER_TTS_SETUP.md
# Set to true when Piper is installed locally or running as service
PIPER_TTS_ENABLED=false
PIPER_BINARY_PATH=/usr/bin/piper
PIPER_MODELS_PATH=/usr/share/piper-tts/models
# Supported: en, hi, kn, te, ta, ml
PIPER_DEFAULT_VOICE=en

# === AI SERVICE (Groq) ===
# Get key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=mixtral-8x7b-32768

# === OTP (One-Time Password) ===
OTP_ENABLED=false
OTP_PROVIDER=console

# === CORS & SECURITY ===
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# === LOGGING ===
LOG_LEVEL=info
LOG_FORMAT=combined

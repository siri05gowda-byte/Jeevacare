# ============================================================================
# JeevaCare — Server Environment Template
# Copy to .env and fill in real values. NEVER commit .env to git.
# ============================================================================

NODE_ENV=development
PORT=5000

# --- DATABASE ---
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/jeevacare?retryWrites=true&w=majority
TEST_MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/jeevacare-test?retryWrites=true&w=majority

# --- JWT ---
JWT_SECRET=generate-with-openssl-rand-base64-48
JWT_EXPIRATION=24h
REFRESH_TOKEN_SECRET=generate-with-openssl-rand-base64-48-different-from-jwt
REFRESH_TOKEN_EXPIRATION=7d

# --- CLOUDINARY ---
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# --- GROQ AI ---
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=mixtral-8x7b-32768

# --- ADMIN BOOTSTRAP ---
JEEVACARE_ADMIN_SECRET=your-strong-admin-passphrase

# --- CORS ---
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# --- EMERGENCY TOKENS ---
EMERGENCY_TOKEN_SECRET=your-emergency-token-secret-min-32-chars
EMERGENCY_TOKEN_EXPIRY_DAYS=365

# --- MEDICAL IMAGE AI ---
MEDICAL_IMAGE_AI_ENABLED=false
MEDICAL_IMAGE_AI_MODEL_PATH=
MEDICAL_IMAGE_AI_DEVICE=cpu

# --- OCR ---
OCR_SERVICE_ENABLED=true
OCR_TIMEOUT_MS=60000
OCR_MAX_FILE_SIZE=10485760

# --- LOGGING ---
LOG_LEVEL=info
LOG_FORMAT=combined

# --- RATE LIMITING ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# --- OTP/SMS/EMAIL (disabled) ---
OTP_ENABLED=false
OTP_PROVIDER=console
SMS_API_KEY=
SMS_API_URL=
EMAIL_API_KEY=
EMAIL_API_URL=

# --- TTS (ON HOLD) ---
TTS_SERVICE_ENABLED=false
TTS_SERVICE_PROVIDER=piper
PIPER_TTS_ENABLED=false
PIPER_BINARY_PATH=
PIPER_MODELS_PATH=
PIPER_DEFAULT_VOICE=en
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_API_ENDPOINT=https://dhruva-api.bhashini.gov.in/services

# --- GOOGLE SHEETS (optional) ---
GOOGLE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEETS_WEBHOOK_URL=

# --- EXTERNAL INTEGRATIONS (all mocked) ---
LABORATORY_ENABLED=false
LABORATORY_MODE=mock
LABORATORY_BASE_URL=
LABORATORY_NAME=
LAB_API_KEY=
LAB_API_CODE=
DIAGNOSTIC_CENTER_ENABLED=false
DIAGNOSTIC_CENTER_MODE=mock
DIAGNOSTIC_CENTER_BASE_URL=
DIAGNOSTIC_CENTER_NAME=
DIAGNOSTIC_CENTER_ID=
DIAGNOSTIC_DICOM_ENABLED=false
DIAGNOSTIC_API_KEY=
HOSPITAL_API_USERNAME=
HOSPITAL_API_PASSWORD=
HOSPITAL_API_KEY=
DIGILOCKER_ENABLED=false
DIGILOCKER_MODE=sandbox
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_REDIRECT_URI=
DIGILOCKER_BASE_URL=
DIGILOCKER_SANDBOX_URL=

# --- SEED SCRIPTS ---
DEMO_ADMIN_PASSWORD=
DEMO_USER_PASSWORD=
RUN_SEED_DRY_RUN=true
RUN_SEED_ACTUAL=false
SEED_DRY_RUN=true

# JeevaCare Environment Variables Template
# Copy this to .env and fill with actual values
# ⚠️ NEVER commit .env with real credentials to version control

# ============================================================================
# REQUIRED: Application Environment
# ============================================================================
NODE_ENV=production
PORT=5000

# ============================================================================
# REQUIRED: MongoDB Atlas Connection
# ============================================================================
# Get from MongoDB Atlas Dashboard → Connect → Drivers
# Format: mongodb+srv://<username>:<password>@cluster.mongodb.net/<database>
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/jeevacare?retryWrites=true&w=majority

# Optional: Test database (only needed for local testing)
# TEST_MONGODB_URI=mongodb://localhost:27017/jeevacare-test

# ============================================================================
# REQUIRED: JWT Secrets (PRODUCTION)
# ============================================================================
# Generate with: openssl rand -base64 64
# ⚠️ Must be unique, cryptographically random, 32+ chars for production
JWT_SECRET=your-secure-jwt-secret-min-32-chars-replace-in-production
REFRESH_TOKEN_SECRET=your-secure-refresh-secret-different-from-jwt-secret

# Optional: Token expiration
# JWT_EXPIRATION=24h
# REFRESH_TOKEN_EXPIRATION=7d

# ============================================================================
# REQUIRED: CORS Configuration
# ============================================================================
# Production: Comma-separated list of allowed origins (no trailing slash)
# Example: https://jeevacare.vercel.app,https://jeevacare-staging.vercel.app
CORS_ORIGIN=https://jeevacare.vercel.app

# ============================================================================
# REQUIRED: Cloudinary (File Storage)
# ============================================================================
# Get from Cloudinary Dashboard → Settings → Access Keys
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ============================================================================
# REQUIRED: Groq AI Service
# ============================================================================
# Get from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
# Optional: Model selection (default: mixtral-8x7b-32768)
# Valid options: mixtral-8x7b-32768, llama2-70b-4096, gemma-7b-it, etc.
# GROQ_MODEL=mixtral-8x7b-32768

# ============================================================================
# OPTIONAL: Piper TTS (Text-to-Speech)
# ============================================================================
# Enable Piper TTS for audio generation (true/false)
# PIPER_TTS_ENABLED=false

# Linux/Render: Use system-installed piper
# PIPER_BINARY_PATH=piper
# PIPER_MODELS_PATH=/usr/share/piper-tts/models

# Windows development:
# PIPER_BINARY_PATH=C:\piper\piper.exe
# PIPER_MODELS_PATH=C:\Users\user\piper-models

# Default voice language (en, hi, ml)
# PIPER_DEFAULT_VOICE=en

# ============================================================================
# OPTIONAL: Security & Rate Limiting
# ============================================================================
# Rate limiting window in milliseconds (default: 900000 = 15 minutes)
# RATE_LIMIT_WINDOW_MS=900000
# Rate limiting max requests per window (default: 100)
# RATE_LIMIT_MAX_REQUESTS=100

# ============================================================================
# OPTIONAL: Logging
# ============================================================================
# Log level: error, warn, info, http, verbose, debug, silly (default: info)
# LOG_LEVEL=info
# Log format: combined, dev, simple, json (default: combined)
# LOG_FORMAT=combined

# ============================================================================
# OPTIONAL: OCR Service (Tesseract.js)
# ============================================================================
# Timeout for OCR operations in milliseconds (default: 60000)
# OCR_TIMEOUT_MS=60000
# Max file size for OCR in bytes (default: 10485760 = 10MB)
# OCR_MAX_FILE_SIZE=10485760

# ============================================================================
# OPTIONAL: OTP/SMS/Email (Not yet implemented)
# ============================================================================
# OTP_ENABLED=false
# OTP_PROVIDER=console
# SMS_API_KEY=
# SMS_API_URL=
# EMAIL_API_KEY=
# EMAIL_API_URL=

# ============================================================================
# OPTIONAL: DigiLocker Integration (Not yet implemented)
# ============================================================================
# DIGILOCKER_ENABLED=false
# DIGILOCKER_CLIENT_ID=
# DIGILOCKER_CLIENT_SECRET=
# DIGILOCKER_REDIRECT_URI=

# ============================================================================
# OPTIONAL: External Services (Mock by default)
# ============================================================================
# Laboratory Integration
# LABORATORY_ENABLED=false
# LABORATORY_MODE=mock
# LABORATORY_BASE_URL=
# LABORATORY_NAME=

# Diagnostic Center Integration
# DIAGNOSTIC_CENTER_ENABLED=false
# DIAGNOSTIC_CENTER_MODE=mock
# DIAGNOSTIC_CENTER_BASE_URL=
# DIAGNOSTIC_CENTER_NAME=

# Hospital Provider Integration
# HOSPITAL_API_USERNAME=
# HOSPITAL_API_PASSWORD=
# HOSPITAL_API_KEY=

# ============================================================================
# Google Sheets Synchronization (Secondary Demo Sync Layer)
# ============================================================================
# 1. Create a Google Sheet titled "JeevaCare Demo Database" with 7 tabs:
#    [Hospitals, Users, Doctors, Patients, StaffRegistrationRequests, MedicalReports, AuditLog]
# 2. In Google Cloud Console, create a Service Account, generate a JSON Key, and share the Google Sheet with Editor access.
# 3. Add these variables to your environment / Render Dashboard:
GOOGLE_SHEETS_SPREADSHEET_ID=your-google-sheets-spreadsheet-id
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project-id.iam.gserviceaccount.com
# Canonical private key variable (handles escaped \n sequences and surrounding quotes):
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
# Supported alias: GOOGLE_PRIVATE_KEY (automatically recognized as fallback)
# GOOGLE_PRIVATE_KEY=
# Optional fallback webhook URL:
# GOOGLE_SHEETS_WEBHOOK_URL=

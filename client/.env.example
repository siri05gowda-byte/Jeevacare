# ============================================================================
# JeevaCare — Frontend Environment Template
# Copy to .env and adjust. NEVER commit .env to git.
# ============================================================================

# Local development (default)
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Production (use this when testing against Render)
# VITE_API_BASE_URL=https://jeevacare-th88.onrender.com/api/v1

# Optional API timeout (ms)
VITE_API_TIMEOUT=30000

# ClaraMed (separate AI website). Adds a "Radiology AI" link to the sidebar when set (https, or localhost for development).
# VITE_CLARAMED_BASE_URL=https://your-claramed-app.streamlit.app
